# Finovara backend configuration. Copy to .env and fill in.
# NEVER commit .env. No credential belongs in source control.

APP_ENV=development                 # development | staging | production
APP_NAME="Finovara ERP API"
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                      # force true in staging/production

# --- Database (Supabase Postgres) -------------------------------------------
# Session pooler (port 5432) for migrations, transaction pooler (6543) for the app.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
# Set true when pointing DATABASE_URL at pgbouncer in transaction mode (port 6543).
DATABASE_USE_PGBOUNCER=false

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 projects: set the JWT secret. Asymmetric projects: leave blank
# and the JWKS endpoint is used instead.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256        # HS256 | RS256 | ES256
SUPABASE_JWT_AUDIENCE=authenticated

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# --- Session / cookies -------------------------------------------------------
COOKIE_DOMAIN=
COOKIE_SECURE=true                  # must stay true outside local development
COOKIE_SAMESITE=lax                 # lax | strict | none
ACCESS_TOKEN_COOKIE=fv_access
REFRESH_TOKEN_COOKIE=fv_refresh
CSRF_COOKIE=fv_csrf
CSRF_HEADER=X-CSRF-Token
ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=604800    # 7 days
IDLE_TIMEOUT_SECONDS=1800           # 30 minutes
ABSOLUTE_SESSION_TIMEOUT_SECONDS=43200

# --- Security ----------------------------------------------------------------
# Vite dev server runs on 5173; add your deployed frontend origin for staging/prod.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_SECONDS=900
MAX_UPLOAD_BYTES=20971520

# --- Email (Brevo SMTP Relay) ------------------------------------------------
# Use Brevo's SMTP relay. SMTP_PASSWORD = your Brevo API key.
# Brevo SMTP host: smtp-relay.brevo.com  port: 587  (STARTTLS)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-brevo-sender-email>
SMTP_PASSWORD=<your-brevo-api-key>
SMTP_FROM="Finovara Advisory <your-sender@email.com>"
SMTP_STARTTLS=true

# Brevo transactional API (optional – for future API-based sending)
BREVO_API_KEY=<your-brevo-api-key>
BREVO_SENDER_EMAIL=<your-brevo-sender-email>
BREVO_SENDER_NAME="Finovara Advisory"
