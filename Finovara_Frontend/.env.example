# Finovara frontend configuration. Copy to .env.local and fill in.
# .env.local is gitignored — never commit real keys.

# Backend API base (FastAPI). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project — anon key is public/browser-safe by design.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
