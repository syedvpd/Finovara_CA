{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "finovara-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "cwd": "Finovara_Frontend",
      "port": 5173
    },
    {
      "name": "finovara-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "backend",
      "port": 8000
    }
  ]
}
